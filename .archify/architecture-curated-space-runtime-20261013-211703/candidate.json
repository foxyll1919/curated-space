  "cards": [
    {
      "dot": "cyan",
      "title": "Primary request path",
      "items": [
        "The browser posts a multipart screenshot; the API sanitizes it, stores the image and pending row, then returns 202.",
        "An in-process bounded job runs the pipeline; the pipeline reads the image, calls Gemini, optionally predicts local labels, and persists the result."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust and input handling",
      "items": [
        "The client is outside the trusted application boundary; image size and decoded content are checked before storage.",
        "The configured Gemini provider is an external boundary. Its API key is held by the backend; local classification stays in the runtime."
      ]
    },
    {
      "dot": "emerald",
      "title": "Runtime and persistence",
      "items": [
        "FastAPI owns the request routes and startup recovery; background work uses FastAPI BackgroundTasks with a concurrency bound.",
        "SQLite stores item metadata, analysis cache, and usage records. Local disk stores sanitized image bytes under opaque keys.",
        "Classification is a challenger: unavailable or failed predictions do not prevent extracted items from reaching ready."
      ]
    }
  ]
