  "cards": [
    {
      "dot": "slate",
      "title": "No Reasoning Loop",
      "items": [
        "The graph edges are START → supervisor → retrieval → answer → END.",
        "There is no reflection, critique, retry or return edge to the supervisor in the implementation."
      ]
    },
    {
      "dot": "emerald",
      "title": "Rewrite Before Routing",
      "items": [
        "With chat history, Gemini rewrites the follow-up into a standalone query first; failures fall back to the original question.",
        "Routing and retrieval both use the rewritten query."
      ]
    },
    {
      "dot": "rose",
      "title": "Terminal Branches",
      "items": [
        "A missing provider returns a configuration message.",
        "An empty result set returns an insufficient-evidence message without answer generation; weak semantic matches are dropped by the 0.35 cutoff."
      ]
    }
  ]
