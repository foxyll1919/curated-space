  "cards": [
    {
      "dot": "cyan",
      "title": "Single-Agent Graph",
      "items": [
        "One LangGraph agent runs supervisor, retrieval and answer nodes in a fixed order.",
        "The graph is a one-pass sequence with no iterative reasoning or re-planning cycle."
      ]
    },
    {
      "dot": "orange",
      "title": "No Tool Layer",
      "items": [
        "The earlier LangChain tool wrapper has been removed; the retrieval node calls keyword_search, semantic_search and hybrid_search directly.",
        "Search results are stored in agent state, so there is no second retrieval pass."
      ]
    },
    {
      "dot": "emerald",
      "title": "Follow-up Rewrite",
      "items": [
        "When history is present, Gemini rewrites the follow-up into a standalone query before routing.",
        "Both the route and the search use the rewritten query; failures fall back to the original question."
      ]
    }
  ]
