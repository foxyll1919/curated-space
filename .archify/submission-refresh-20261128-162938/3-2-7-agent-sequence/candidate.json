  "cards": [
    {
      "dot": "emerald",
      "title": "Follow-up Rewrite",
      "items": [
        "Ask history is persisted in the browser and the last six messages are sent with each question.",
        "When history is present, the supervisor rewrites the question into a standalone query before routing; on failure it searches the original question."
      ]
    },
    {
      "dot": "orange",
      "title": "No Tool Round-Trip",
      "items": [
        "The LangChain search tool was removed, so the retrieval node calls the search functions once and keeps the returned records.",
        "There is no discarded tool result and no second retrieval pass."
      ]
    },
    {
      "dot": "slate",
      "title": "Evidence Control",
      "items": [
        "Semantic matches below a 0.35 cosine similarity score are dropped.",
        "Returned sources are filtered to the screenshot IDs the answer actually cites, falling back to all retrieved results when none are cited."
      ]
    }
  ]
