  "cards": [
    {
      "dot": "emerald",
      "title": "Follow-up Rewrite",
      "items": [
        "Chat history is persisted in the browser and the last six messages accompany each Ask request.",
        "When history exists, Gemini rewrites the follow-up into a standalone query before routing; a failure falls back to the original question."
      ]
    },
    {
      "dot": "orange",
      "title": "Retrieval Semantics",
      "items": [
        "Keyword search uses SQLite FTS5 or Postgres full-text search, and falls back from AND to OR with a stop-word list.",
        "Semantic matches below a 0.35 cosine similarity score are dropped, so weak evidence yields no results."
      ]
    },
    {
      "dot": "slate",
      "title": "Chunking Is Not Implemented",
      "items": [
        "Title, description and tags are joined into one text per screenshot.",
        "There is no document splitter or multiple chunks per screenshot; each item has one embedding record.",
        "Sources return only the screenshot IDs the answer cites, or all retrieved results when none are cited."
      ]
    }
  ]
