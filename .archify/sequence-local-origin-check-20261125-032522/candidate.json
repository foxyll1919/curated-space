  "cards": [
    {
      "dot": "rose",
      "title": "Why the 403 Happens",
      "items": [
        "The origin guard checks POST requests before the login route.",
        "The browser origin must match the request host or an explicit allowed origin."
      ]
    },
    {
      "dot": "emerald",
      "title": "Local Fix",
      "items": [
        "Use ALLOWED_ORIGINS=[\"http://localhost:5173\"] in backend/.env.",
        "Restart the backend so the running process reloads settings.",
        "Use the origin only; do not add /login or a trailing slash."
      ]
    }
  ]
