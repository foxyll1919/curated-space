# Copy this file to .env. .env is git-ignored.
#
# There is no API_KEY here any more: you sign in at /login and the backend sets
# an httpOnly session cookie. The cookie is same-origin, so nothing in this file
# is needed for authentication.
#
# BACKEND_URL is where the backend listens. Defaults to http://localhost:8000.
# Do not name it VITE_*: Vite would inline it into the JavaScript bundle, and
# this file is not the place for secrets any more.
BACKEND_URL=http://localhost:8000