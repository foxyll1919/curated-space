# Copy this file to .env and fill in the values. .env is git-ignored.
#
# API_KEY must match the API_KEY in backend/.env. It is read by vite.config.ts
# with loadEnv and injected as the X-API-Key header by the dev-server proxy.
# It is never bundled into client code, so it must NOT be named VITE_*.
API_KEY=

# Where the backend is listening. Defaults to http://localhost:8000.
BACKEND_URL=http://localhost:8000